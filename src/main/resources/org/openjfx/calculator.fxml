      <Button fx:id="nineButton" ellipsisString="1" layoutX="111.0" layoutY="177.0" mnemonicParsing="false" onAction="#handleNumberClick" prefHeight="40.0" prefWidth="40.0" styleClass="calculator-button" text="9" />
