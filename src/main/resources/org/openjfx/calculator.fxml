      <Button fx:id="commaButton" ellipsisString="1" layoutX="112.0" layoutY="333.0" mnemonicParsing="false" onAction="#handleNumberClick" prefHeight="40.0" prefWidth="40.0" styleClass="calculator-button" text="," />
