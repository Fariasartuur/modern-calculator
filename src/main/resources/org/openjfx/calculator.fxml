            <Font name="System Bold" size="20.0" />
         </font>
      </TextArea>
      <Button fx:id="sevenButton" ellipsisString="1" layoutX="11.0" layoutY="177.0" mnemonicParsing="false" onAction="#handleNumberClick" prefHeight="40.0" prefWidth="40.0" styleClass="calculator-button" text="7">
         <font>
            <Font name="Arial" size="12.0" />
         </font></Button>
