<AnchorPane prefHeight="387.0" prefWidth="214.0" styleClass="calculator-background" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.openjfx.Controler">
