      <Button fx:id="twoButton" ellipsisString="1" layoutX="61.0" layoutY="281.0" mnemonicParsing="false" onAction="#handleNumberClick" prefHeight="40.0" prefWidth="40.0" styleClass="calculator-button" text="2" />
      <Button fx:id="threeButton" ellipsisString="1" layoutX="111.0" layoutY="281.0" mnemonicParsing="false" onAction="#handleNumberClick" prefHeight="40.0" prefWidth="40.0" styleClass="calculator-button" text="3" />
