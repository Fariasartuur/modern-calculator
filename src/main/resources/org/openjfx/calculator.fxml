      <Button fx:id="multiplyButton" ellipsisString="1" layoutX="161.0" layoutY="177.0" mnemonicParsing="false" onAction="#handleOperatorClick" prefHeight="40.0" prefWidth="40.0" styleClass="operator-button" text="*" />
      <Button fx:id="addButton" ellipsisString="1" layoutX="161.0" layoutY="229.0" mnemonicParsing="false" onAction="#handleOperatorClick" prefHeight="40.0" prefWidth="40.0" styleClass="operator-button" text="+" />
